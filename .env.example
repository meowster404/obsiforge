# ====================================================================
# OBSIFORGE // ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Instructions:
# 1. Copy this file to a new file named: .env
# 2. Replace the placeholder values with your real credentials.
# 3. Never commit your .env file into version control (git).
# ====================================================================

# --------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE CREDENTIALS [CONFIDENTIAL]
# --------------------------------------------------------------------
# How to get your connection string:
# 1. Go to https://neon.tech and log into your console.
# 2. Create or select your Project -> Dashboard.
# 3. Copy the pooled or direct connection string:
# --------------------------------------------------------------------
VITE_NEON_DATABASE_URL="postgresql://obsiforge_owner:your_password_here@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://obsiforge_owner:your_password_here@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION PEPPER [CONFIDENTIAL]
# --------------------------------------------------------------------
# Used to salt master key hashes and encrypt sensitive cloud credentials:
OBSIFORGE_ENCRYPTION_SECRET="obsiforge_secure_master_salt_key_change_me"

# --------------------------------------------------------------------
# 3. BASE MINECRAFT JOINING DOMAIN
# --------------------------------------------------------------------
# ObsiForge automatically generates a unique public multiplayer address
# for every Minecraft server following the pattern:
#   {SERVER_NAME}.{RANDOM_CODE}.obsiforge.ply.gg
#
# You can customize the root domain here (Default: obsiforge.ply.gg):
VITE_BASE_TUNNEL_DOMAIN="obsiforge.ply.gg"
VITE_DEFAULT_MC_PORT="25565"
VITE_APP_TITLE="OBSIFORGE"

# --------------------------------------------------------------------
# 4. UPSTREAM MINECRAFT ENGINE & MOD APIs (PUBLIC REST ENDPOINTS)
# --------------------------------------------------------------------
# Note: These are official open-source endpoints that do NOT require
# any API keys or bearer tokens. You can override them if you run custom mirrors:
VITE_MOJANG_MANIFEST_URL="https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"
VITE_PAPER_API_URL="https://api.papermc.io/v2/projects/paper"
VITE_PURPUR_API_URL="https://api.purpurmc.org/v2/purpur"
VITE_FABRIC_META_URL="https://meta.fabricmc.net/v2/versions"
VITE_MODRINTH_API_URL="https://api.modrinth.com/v2"

# --------------------------------------------------------------------
# 5. ORACLE CLOUD (OCI) CREDENTIALS & RSA KEYS
# --------------------------------------------------------------------
# Per security architecture, Oracle Cloud credentials and RSA private
# keys are inputted directly by the user in the GUI under [7] 24/7 CLOUD
# and are encrypted with AES-256 before persisting to your Neon DB.

# --------------------------------------------------------------------
# 6. GITHUB REPOSITORY & AUTO-UPDATES
# --------------------------------------------------------------------
# Format: "your-github-username/your-repository-name"
# ObsiForge queries this repository's GitHub Releases API for new versions & .exe installers:
VITE_GITHUB_REPO="{your-username}/obsiforge"

