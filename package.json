{
  "name": "obsiforge",
  "private": true,
  "version": "1.0.2b",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "ObsiForge - Cyber-Industrial Terminal CLI Minecraft Server Core with Neon DB & Oracle Cloud Integration",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc -b && vite build",
    "package": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.obsiforge.app",
    "productName": "ObsiForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ObsiForge"
    }
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "lucide-react": "^1.59.0",
    "pidusage": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
